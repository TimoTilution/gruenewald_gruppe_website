Options -MultiViews

RewriteEngine On

# Keep one canonical host for users, search engines and cached client bundles.
# Preserve the complete path and query string on the redirect.
RewriteCond %{HTTP_HOST} ^gruenewald-gruppe\.de$ [NC]
RewriteRule ^ https://www.gruenewald-gruppe.de%{REQUEST_URI} [R=301,L,NE]

# A stale client-side navigation can request an exported Next.js payload with
# a duplicated slash and then expose that text file as the visible URL.
RewriteCond %{THE_REQUEST} "\s/+((?:tilution|gruenewaldgmbh|clay-construction|verwaltung|hrw))/{2,}index\.txt(?:[?\s])" [NC]
RewriteRule ^ /%1/ [R=302,L,NE]

# Repair legacy domain forwards whose destination prefix was configured
# without a separating slash (for example /gruenewaldgmbhreferenzen/).
RewriteRule ^gruenewaldgmbh([^/].*)$ /gruenewaldgmbh/$1 [R=301,L,NE]
RewriteRule ^tilution([^/].*)$ /tilution/$1 [R=301,L,NE]
RewriteRule ^clay-construction([^/].*)$ /clay-construction/$1 [R=301,L,NE]
RewriteRule ^verwaltung([^/].*)$ /verwaltung/$1 [R=301,L,NE]
RewriteRule ^hrw([^/].*)$ /hrw/$1 [R=301,L,NE]
